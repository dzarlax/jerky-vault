services:
  backend:
    image: golang:1.25.10-alpine
    working_dir: /app
    ports:
      - "${BACKEND_PORT:-8080}:8080"
    environment:
      DATABASE_URL: "${BATCHVAULT_DATABASE_URL:?Set BATCHVAULT_DATABASE_URL in docker-compose.dev.yml or your shell}"
      FRONT_URL: "${BATCHVAULT_FRONTEND_URL:-http://127.0.0.1:3000}"
      JWT_SECRET: "${BATCHVAULT_JWT_SECRET:-local-dev-jwt-secret-change-me}"
    volumes:
      - ${BATCHVAULT_BACKEND_CONTEXT:-../jerky-vault-back}:/app
      - batchvault_go_mod_cache:/go/pkg/mod
      - batchvault_go_build_cache:/root/.cache/go-build
    command: sh -c "go mod download && go run ."

  backend-image:
    build:
      context: ${BATCHVAULT_BACKEND_CONTEXT:-../jerky-vault-back}
      dockerfile: Dockerfile
    profiles:
      - image
    ports:
      - "${BACKEND_IMAGE_PORT:-8081}:8080"
    environment:
      DATABASE_URL: "${BATCHVAULT_DATABASE_URL:?Set BATCHVAULT_DATABASE_URL in docker-compose.dev.yml or your shell}"
      FRONT_URL: "${BATCHVAULT_FRONTEND_URL:-http://127.0.0.1:3000}"
      JWT_SECRET: "${BATCHVAULT_JWT_SECRET:-local-dev-jwt-secret-change-me}"

  frontend:
    image: node:20-alpine
    working_dir: /app
    depends_on:
      - backend
    ports:
      - "${FRONTEND_PORT:-3000}:3000"
    environment:
      NODE_ENV: development
      NEXT_TELEMETRY_DISABLED: "1"
      SKIP_ENV_VALIDATION: "true"
      NEXT_PUBLIC_API_URL: "${BATCHVAULT_API_URL:-http://127.0.0.1:8080}"
      NEXT_PUBLIC_FRONTEND_URL: "${BATCHVAULT_FRONTEND_URL:-http://127.0.0.1:3000}"
      NEXT_PUBLIC_AUTH_ENABLED: "${NEXT_PUBLIC_AUTH_ENABLED:-true}"
    volumes:
      - .:/app
      - batchvault_node_modules:/app/node_modules
      - batchvault_next:/app/.next
    command:
      - sh
      - -lc
      - |
        if [ ! -x node_modules/.bin/next ]; then npm ci; fi
        cat > public/config.js <<EOF
        window.__RUNTIME_CONFIG__ = {
          API_URL: "$${NEXT_PUBLIC_API_URL:-http://localhost:8080}",
          MAPBOX_ACCESS_TOKEN: "$${MAPBOX_ACCESS_TOKEN:-}"
        };
        EOF
        npm run dev -- -H 0.0.0.0 -p 3000

  builder:
    image: node:20-alpine
    working_dir: /app
    profiles:
      - tools
    environment:
      NODE_ENV: production
      NEXT_TELEMETRY_DISABLED: "1"
      NEXT_DISABLE_SSG: "true"
      SKIP_ENV_VALIDATION: "true"
      NEXT_PUBLIC_API_URL: "${BATCHVAULT_API_URL:-http://127.0.0.1:8080}"
      NEXT_PUBLIC_FRONTEND_URL: "${BATCHVAULT_FRONTEND_URL:-http://127.0.0.1:3000}"
      NEXT_PUBLIC_AUTH_ENABLED: "${NEXT_PUBLIC_AUTH_ENABLED:-true}"
    volumes:
      - .:/app
      - batchvault_node_modules:/app/node_modules
      - batchvault_next:/app/.next
    command: sh -lc "npm ci && npm run build:no-ssg"

volumes:
  batchvault_node_modules:
  batchvault_next:
  batchvault_go_mod_cache:
  batchvault_go_build_cache:
