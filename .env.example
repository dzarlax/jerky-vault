# Environment variables for JerkyVault application

# API URL for backend connection
NEXT_PUBLIC_API_URL=https://api.jerky.in.rs

# Mapbox access token for maps
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Frontend URL for CORS and redirects
NEXT_PUBLIC_FRONTEND_URL=https://admin.jerky.in.rs

# Authentication settings
NEXT_PUBLIC_AUTH_ENABLED=true

# Build optimization flags
NEXT_PUBLIC_OPTIMIZE_IMAGES=true
NEXT_PUBLIC_OPTIMIZE_FONTS=true

# Disable static generation for authenticated routes during build
NEXT_PUBLIC_SKIP_AUTH_ROUTES_SSG=true

# Server-side rendering settings
NEXT_DISABLE_SSG=true
SKIP_ENV_VALIDATION=true

# Node environment
NODE_ENV=production
