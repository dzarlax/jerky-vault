# ==============================================
# JerkyVault Environment Configuration
# ==============================================

# Node.js Environment
NODE_ENV=development

# ==============================================
# API Configuration
# ==============================================

# Backend API URL (required for frontend-backend communication)
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Frontend URL (for CORS and redirects)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ==============================================
# Authentication & Security
# ==============================================

# JWT Secret for token signing (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_please_change_this

# General application secret key
SECRET=your_general_secret_key_here_please_change_this

# Enable/disable authentication system
NEXT_PUBLIC_AUTH_ENABLED=true

# ==============================================
# Database Configuration
# ==============================================

# Database connection details
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=jerky_vault_user
DATABASE_PASSWORD=your_database_password_here
DATABASE_NAME=jerky_vault

# Alternative: Full database URL (PostgreSQL example)
# DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# ==============================================
# External Services
# ==============================================

# Mapbox access token (optional, for map features)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# ==============================================
# Build & Development Flags
# ==============================================

# Skip environment validation during build (useful for Docker)
SKIP_ENV_VALIDATION=false

# Disable static site generation
NEXT_DISABLE_SSG=false

# Optimize images during build
NEXT_PUBLIC_OPTIMIZE_IMAGES=true

# Optimize fonts during build
NEXT_PUBLIC_OPTIMIZE_FONTS=true

# Skip SSG for authenticated routes
NEXT_PUBLIC_SKIP_AUTH_ROUTES_SSG=false

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# ==============================================
# Production Settings (Docker)
# ==============================================

# For production Docker deployment, set these:
# NODE_ENV=production
# SKIP_ENV_VALIDATION=true
# NEXT_DISABLE_SSG=true
# NEXT_PUBLIC_SKIP_AUTH_ROUTES_SSG=true
